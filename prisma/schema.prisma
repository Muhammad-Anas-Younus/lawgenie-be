// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  LAWYER
  MUFTI
  ADMIN
}

// Lawyers and Muftis start PENDING_VERIFICATION on registration and only
// become publicly visible / usable once an admin verifies their credentials.
enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String?  @unique
  phone             String?  @unique
  passwordHash      String
  role              Role
  // Contact (OTP) verification — distinct from LawyerProfile/MuftiProfile's
  // credential VerificationStatus, which admin review gates separately.
  isVerified        Boolean  @default(false)
  // Freeform per-role notification toggles (12.1) — shape varies enough by
  // role (client/lawyer/mufti/admin each show different toggles) that a
  // fixed relational schema isn't worth it, same rationale as
  // LawyerProfile.feeStructure.
  notificationPrefs Json     @default("{}")
  createdAt         DateTime @default(now())

  lawyerProfile LawyerProfile?
  muftiProfile  MuftiProfile?
  adminProfile  AdminProfile?

  consultationsAsClient Consultation[] @relation("ClientConsultations")
  consultationsAsLawyer Consultation[] @relation("LawyerConsultations")
  reviewedPayments      Payment[]      @relation("PaymentReviewer")
  sentMessages          Message[]      @relation("MessageSender")
  documents             Document[]     @relation("DocumentOwner")
  proposalsAsLawyer     Proposal[]     @relation("LawyerProposals")
  proposalsAsClient     Proposal[]     @relation("ClientProposals")
  casesAsClient         Case[]         @relation("ClientCases")
  casesAsLawyer         Case[]         @relation("LawyerCases")
  reviewsGiven          Review[]       @relation("ReviewsGiven")
  reviewsReceived       Review[]       @relation("ReviewsReceived")
  muftiQueriesAsLawyer  MuftiQuery[]   @relation("LawyerMuftiQueries")
  muftiQueriesAsMufti   MuftiQuery[]   @relation("MuftiMuftiQueries")
  disputesRaised        Dispute[]      @relation("DisputeRaisedBy")
}

model LawyerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Credential documents submitted at registration, verified by an admin.
  barCouncilLicenseUrl    String
  cnicUrl                 String
  educationCredentialsUrl String?

  bio             String?
  city            String?
  specialization  String[]
  experienceYears Int?
  // Base consultation fee (PKR) — its own column (rather than only inside
  // feeStructure) so the directory can filter/sort on it directly.
  consultationFee Int?
  // Retainer, milestone, hourly rate — shape varies enough per lawyer that
  // a fixed relational schema isn't worth it for these.
  feeStructure    Json?
  availability    Json?
  languages       String[]
  jurisdictions   String[]

  // Denormalized from Review once that model lands (Phase 9) so directory
  // filtering/sorting by rating doesn't require aggregating on every request.
  averageRating Float?
  reviewCount   Int    @default(0)

  // Recomputed on every /me update from bio/city/experienceYears/
  // consultationFee/specialization — an unverified profile stub shouldn't be
  // bookable even after admin verification. Gates directory visibility and
  // consultation booking alongside verificationStatus (see lawyerService).
  isProfileCompleted Boolean @default(false)

  verificationStatus VerificationStatus @default(PENDING_VERIFICATION)
  verificationReason String?

  createdAt DateTime @default(now())
}

model MuftiProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialsUrl String

  bio            String?
  specialization String[]
  languages      String[]

  verificationStatus VerificationStatus @default(PENDING_VERIFICATION)
  verificationReason String?

  createdAt DateTime @default(now())
}

model AdminProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// A consultation is a single paid video meeting between a client and a
// lawyer. No in-house video infra — once payment is admin-approved
// (Phase 4), a meeting link is generated and stored on `meetingLink`.
enum ConsultationStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model Consultation {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation("ClientConsultations", fields: [clientId], references: [id])
  lawyerId String
  lawyer   User   @relation("LawyerConsultations", fields: [lawyerId], references: [id])

  // Snapshotted from the lawyer's consultationFee at booking time, so a
  // later fee change doesn't retroactively alter an existing booking.
  fee         Int
  scheduledAt DateTime
  status      ConsultationStatus @default(PENDING_PAYMENT)
  // Set once an admin approves the payment (Phase 4) — see model comment above.
  meetingLink String?

  createdAt DateTime @default(now())

  payments  Payment[]
  proposals Proposal[]
  reviews   Review[]
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Polymorphic proof-of-payment record: exactly one of consultationId/
// caseId/milestoneId/muftiQueryId is set (enforced by a DB check
// constraint — see the migration). caseId, milestoneId, and muftiQueryId
// all became real relations once their respective models landed (Case in
// Phase 6, Milestone and Hearing in Phase 7, MuftiQuery in Phase 8).
model Payment {
  id             String        @id @default(uuid())
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  caseId         String?
  case           Case?         @relation(fields: [caseId], references: [id])
  milestoneId    String?
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id])
  muftiQueryId   String?
  muftiQuery     MuftiQuery?   @relation(fields: [muftiQueryId], references: [id])

  screenshotUrl String
  amount        Int
  status        PaymentStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reason       String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
}

enum ProposalStatus {
  SENT
  ACCEPTED
  DECLINED
}

// A lawyer's formal engagement offer, sendable only once there's a prior
// APPROVED consultation between the same lawyer and client (no cold
// proposals — enforced in proposalService, not just here in the schema).
// feeStructure carries the free-form terms (retainer amount, case type,
// scope, deliverables, etc.) — same rationale as LawyerProfile.feeStructure:
// shape varies enough per engagement that a fixed relational schema isn't
// worth it. `retainerAmount` inside it is what gets charged as the Payment
// on acceptance.
model Proposal {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  lawyerId       String
  lawyer         User         @relation("LawyerProposals", fields: [lawyerId], references: [id])
  clientId       String
  client         User         @relation("ClientProposals", fields: [clientId], references: [id])

  feeStructure Json
  status       ProposalStatus @default(SENT)

  createdAt DateTime @default(now())

  case Case?

  @@index([consultationId])
}

enum CaseStatus {
  PENDING_PAYMENT
  ACTIVE
  CLOSED
}

// Created the moment a client accepts a Proposal (status PENDING_PAYMENT,
// alongside the retainer Payment); flips to ACTIVE once an admin approves
// that payment (see paymentService/adminService). A client may only have
// one ACTIVE case at a time — enforced in proposalService (at acceptance)
// and again in adminService (at activation, to close the race where two
// proposals are accepted before either retainer is reviewed). Lawyers have
// no such limit.
model Case {
  id         String   @id @default(uuid())
  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  clientId   String
  client     User     @relation("ClientCases", fields: [clientId], references: [id])
  lawyerId   String
  lawyer     User     @relation("LawyerCases", fields: [lawyerId], references: [id])

  status   CaseStatus @default(PENDING_PAYMENT)
  // Simple 0-100 completion indicator the lawyer sets directly (alongside
  // the finer-grained Milestone list) to drive the case dashboard's
  // progress bar (PRD 6.6 "visual progress timeline") — settable via
  // PATCH /api/cases/:id, lawyer-only.
  progress Int        @default(0)

  // Iddat tracker (PRD 6.6 "Special Trackers") — the mandatory waiting
  // period a woman observes after divorce/death of spouse. endDate is
  // computed by caseService as startDate + 90 days (the commonly-used
  // three-lunar-month approximation in Pakistani family law practice) and
  // stored denormalized so it's directly queryable/displayable without
  // recomputing on every read.
  iddatStartDate DateTime?
  iddatEndDate   DateTime?

  // Mehr (dower) tracker (PRD 6.6) — amount in PKR and whether it has been
  // paid. Kept as plain fields rather than a submodel since, like Milestone
  // payments, there's exactly one Mehr per case and no history to track.
  mehrAmount Int?
  mehrPaid   Boolean @default(false)

  createdAt DateTime @default(now())

  payments     Payment[]
  milestones   Milestone[]
  hearings     Hearing[]
  documents    Document[]
  reviews      Review[]
  muftiQueries MuftiQuery[]
  disputes     Dispute[]

  @@index([clientId, status])
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// A concrete step in a case's progress (PRD 6.6 "Milestone tracking:
// document submission, court dates, decisions"). The lawyer creates/
// updates these; both parties and admin can view them via
// GET /api/cases/:id. A milestone's associated payment (PRD 6.7 "milestone
// payment due") is reached via the reverse of Payment.milestoneId rather
// than a forward column here, matching how Case's retainer Payment works.
model Milestone {
  id          String          @id @default(uuid())
  caseId      String
  case        Case            @relation(fields: [caseId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([caseId])
}

// A scheduled court hearing on a case (PRD 6.6 "Court hearing schedule").
// The lawyer creates/updates these; both parties and admin can view them
// via GET /api/cases/:id, and a lawyer can list all of their own upcoming
// hearings across every active case via GET /api/hearings/mine.
model Hearing {
  id       String   @id @default(uuid())
  caseId   String
  case     Case     @relation(fields: [caseId], references: [id])
  date     DateTime
  location String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
}

// Which relationship a Review is rating — CONSULTATION and CASE cover the
// two client<->lawyer directions (client->lawyer post consultation/case
// close, lawyer->client post case close); GUIDANCE covers lawyer->mufti
// post guidance. The task brief shorthanded this as "context
// consultation|case", but a third context is needed to represent the
// lawyer->mufti path distinctly from a plain case review, so it's named
// out explicitly here.
enum ReviewContext {
  CONSULTATION
  CASE
  GUIDANCE
}

// A rating + optional written review from one user of another, gated by
// role/context rules enforced in reviewService (not here): client->lawyer
// (post APPROVED/COMPLETED consultation, or post case close), lawyer->
// client (post case close), lawyer->mufti (post guidance). Exactly one of
// consultationId/caseId/muftiQueryId is set, matching `context`.
// muftiQueryId stays a plain column, not a relation, since the MuftiQuery
// model lands in a parallel track this same wave (same pattern as
// Payment.muftiQueryId above).
model Review {
  id      String @id @default(uuid())
  raterId String
  rater   User   @relation("ReviewsGiven", fields: [raterId], references: [id])
  rateeId String
  ratee   User   @relation("ReviewsReceived", fields: [rateeId], references: [id])

  context        ReviewContext
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  caseId         String?
  case           Case?         @relation(fields: [caseId], references: [id])
  muftiQueryId   String?

  overallStars    Int
  // Category scores (PRD 6.3 "categorized scores") — optional since not
  // every review context (e.g. a quick lawyer->mufti guidance rating)
  // necessarily fills all of them in on the frontend.
  communication   Int?
  expertise       Int?
  value           Int?
  professionalism Int?
  responsiveness  Int?
  text            String?

  // Admin moderation (11.2b) — the other half of message flagging (11.2a),
  // toggled via PATCH /api/admin/reviews/:id/moderate.
  isFlagged Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([rateeId])
  @@index([raterId])
}

// Threads are scoped per consultation or per case, not one continuous
// inbox per client-lawyer pair. threadId is a plain column (not a relation)
// since it points at either Consultation or, once Phase 7 lands, Case —
// ownership/"no contact until paid" checks are enforced in messageService.
enum ThreadType {
  CONSULTATION
  CASE
}

model Message {
  id         String     @id @default(uuid())
  threadType ThreadType
  threadId   String

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  body          String
  attachmentUrl String?
  // Admin moderation (11.2a) — toggled via PATCH /api/admin/messages/:id/flag.
  isFlagged     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadType, threadId])
}

enum DocumentCategory {
  PLEADING
  EVIDENCE
  COURT_ORDER
  PERSONAL
  CREDENTIAL
}

// A document library entry. caseId became a real relation once the Case
// model landed (Phase 7 / Track B) — same pattern as Payment's polymorphic
// FKs above. Versioning: re-uploading "the same" document doesn't create
// an unrelated row — it's posted with `replaces` set to the prior version's
// id, and the service carries the shared `groupId` forward with `version`
// incremented. GET /api/documents returns only the latest version per
// group by default.
model Document {
  id      String  @id @default(uuid())
  ownerId String
  owner   User    @relation("DocumentOwner", fields: [ownerId], references: [id])
  caseId  String?
  case    Case?   @relation(fields: [caseId], references: [id])

  category     DocumentCategory
  url          String
  originalName String
  mimeType     String
  size         Int

  // All versions of the same logical document share a groupId; a
  // first-time upload gets groupId == id.
  groupId String
  version Int    @default(1)

  uploadedAt DateTime @default(now())

  @@index([ownerId])
  @@index([caseId])
  @@index([groupId])
}

// PRD §6.5 fee tiers (PKR) — snapshotted onto MuftiQuery.fee at submission
// time so a later tier price change doesn't alter an existing query, same
// rationale as Consultation.fee.
enum MuftiQueryUrgency {
  STANDARD // 300, 48h response target
  URGENT // 600, 24h response target
  CRITICAL // 1000, 4h response target
}

// PENDING_PAYMENT until the linked Payment is reviewed; admin approval
// moves it to PENDING_RESPONSE (this is what makes it enter the Mufti's
// queue — see muftiQueryService/adminService), rejection is terminal
// (REJECTED, no retry — same pattern as Consultation/Case). RESPONDED once
// a Mufti has answered.
enum MuftiQueryStatus {
  PENDING_PAYMENT
  PENDING_RESPONSE
  RESPONDED
  REJECTED
}

// A lawyer's request for Islamic legal guidance (fatwa) on one of their
// active cases (Mufti consultation is lawyer-only — PRD §6.5, no direct
// client access). Not assigned to a specific Mufti at submission — muftiId
// is nullable and only gets set on response, by whichever verified Mufti
// claims it off the shared queue (GET /mufti-queries/queue). A query is
// only visible in that queue once its linked Payment is `approved` — the
// Mufti never sees a query with an unapproved payment. Islamic guidance
// history for a case is derived by querying RESPONDED rows for that
// caseId at read time rather than a separate log field — see
// muftiQueryService for the reasoning (same "don't duplicate a source of
// truth" rationale as LawyerProfile.averageRating being the one place that
// *does* denormalize, because that one needs cross-request aggregation
// performance; this doesn't).
model MuftiQuery {
  id       String @id @default(uuid())
  caseId   String
  case     Case   @relation(fields: [caseId], references: [id])
  lawyerId String
  lawyer   User   @relation("LawyerMuftiQueries", fields: [lawyerId], references: [id])
  muftiId  String?
  mufti    User?  @relation("MuftiMuftiQueries", fields: [muftiId], references: [id])

  urgency MuftiQueryUrgency
  fee     Int

  question  String
  answer    String?
  // Mandatory Islamic source citations (Quran/Hadith/Fiqh/law references)
  // on response — free text per entry, no fixed structure needed.
  citations String[]

  status MuftiQueryStatus @default(PENDING_PAYMENT)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  // Set once an admin approves this answered query for reuse as chatbot
  // knowledge (11.3) — null means either not yet answered or answered but
  // not curated. Curation upserts the Q&A into the vector store (see
  // muftiQueryService.curateForKnowledgeBase); this timestamp is just the
  // DB-side record of that having happened, not the source of truth for
  // what's actually embedded.
  curatedAt DateTime?

  payments Payment[]

  @@index([caseId])
  @@index([muftiId])
  @@index([status])
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

// A client or lawyer flagging a problem on their own case for admin
// mediation (PRD §6.7/11.1) — e.g. a missed session or a fee disagreement.
// caseId is a real relation (unlike Payment's polymorphic FKs) since a
// dispute is always case-scoped; raisedById can be either party on the
// case, checked in disputeService rather than the schema. `resolution` is
// only set once an admin closes it out via PATCH .../:id.
model Dispute {
  id          String @id @default(uuid())
  raisedById  String
  raisedBy    User   @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  caseId      String
  case        Case   @relation(fields: [caseId], references: [id])

  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?

  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([caseId])
  @@index([status])
}
