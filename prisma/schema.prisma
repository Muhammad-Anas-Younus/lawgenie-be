// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  LAWYER
  MUFTI
  ADMIN
}

// Lawyers and Muftis start PENDING_VERIFICATION on registration and only
// become publicly visible / usable once an admin verifies their credentials.
enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  // Contact (OTP) verification — distinct from LawyerProfile/MuftiProfile's
  // credential VerificationStatus, which admin review gates separately.
  isVerified   Boolean  @default(false)
  // Freeform per-role notification toggles (12.1) — shape varies enough by
  // role (client/lawyer/mufti/admin each show different toggles) that a
  // fixed relational schema isn't worth it, same rationale as
  // LawyerProfile.feeStructure.
  notificationPrefs Json     @default("{}")
  createdAt         DateTime @default(now())

  lawyerProfile LawyerProfile?
  muftiProfile  MuftiProfile?
  adminProfile  AdminProfile?

  consultationsAsClient Consultation[] @relation("ClientConsultations")
  consultationsAsLawyer Consultation[] @relation("LawyerConsultations")
  reviewedPayments      Payment[]      @relation("PaymentReviewer")
  sentMessages          Message[]      @relation("MessageSender")
  documents             Document[]     @relation("DocumentOwner")
  proposalsAsLawyer     Proposal[]     @relation("LawyerProposals")
  proposalsAsClient     Proposal[]     @relation("ClientProposals")
  casesAsClient         Case[]         @relation("ClientCases")
  casesAsLawyer         Case[]         @relation("LawyerCases")
  disputesRaised        Dispute[]      @relation("DisputeRaisedBy")
}

model LawyerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Credential documents submitted at registration, verified by an admin.
  barCouncilLicenseUrl    String
  cnicUrl                 String
  educationCredentialsUrl String?

  bio             String?
  city            String?
  specialization  String[]
  experienceYears Int?
  // Base consultation fee (PKR) — its own column (rather than only inside
  // feeStructure) so the directory can filter/sort on it directly.
  consultationFee Int?
  // Retainer, milestone, hourly rate — shape varies enough per lawyer that
  // a fixed relational schema isn't worth it for these.
  feeStructure    Json?
  availability    Json?
  languages       String[]
  jurisdictions   String[]

  // Denormalized from Review once that model lands (Phase 9) so directory
  // filtering/sorting by rating doesn't require aggregating on every request.
  averageRating Float?
  reviewCount   Int    @default(0)

  verificationStatus VerificationStatus @default(PENDING_VERIFICATION)
  verificationReason String?

  createdAt DateTime @default(now())
}

model MuftiProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialsUrl String

  bio            String?
  specialization String[]
  languages      String[]

  verificationStatus VerificationStatus @default(PENDING_VERIFICATION)
  verificationReason String?

  createdAt DateTime @default(now())
}

model AdminProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// A consultation is a single paid video meeting between a client and a
// lawyer. No in-house video infra — once payment is admin-approved
// (Phase 4), a meeting link is generated and stored on `meetingLink`.
enum ConsultationStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model Consultation {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation("ClientConsultations", fields: [clientId], references: [id])
  lawyerId String
  lawyer   User   @relation("LawyerConsultations", fields: [lawyerId], references: [id])

  // Snapshotted from the lawyer's consultationFee at booking time, so a
  // later fee change doesn't retroactively alter an existing booking.
  fee         Int
  scheduledAt DateTime
  status      ConsultationStatus @default(PENDING_PAYMENT)
  // Set once an admin approves the payment (Phase 4) — see model comment above.
  meetingLink String?

  createdAt DateTime @default(now())

  payments  Payment[]
  proposals Proposal[]
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Polymorphic proof-of-payment record: exactly one of consultationId/
// caseId/milestoneId/muftiQueryId is set (enforced by a DB check
// constraint — see the migration). milestoneId/muftiQueryId stay plain
// nullable columns, not relations, until those models exist (Phase 7/8).
// caseId became a real relation once the Case model landed (Phase 6).
model Payment {
  id             String        @id @default(uuid())
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  caseId         String?
  case           Case?         @relation(fields: [caseId], references: [id])
  milestoneId    String?
  muftiQueryId   String?

  screenshotUrl String
  amount        Int
  status        PaymentStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reason       String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
}

enum ProposalStatus {
  SENT
  ACCEPTED
  DECLINED
}

// A lawyer's formal engagement offer, sendable only once there's a prior
// APPROVED consultation between the same lawyer and client (no cold
// proposals — enforced in proposalService, not just here in the schema).
// feeStructure carries the free-form terms (retainer amount, case type,
// scope, deliverables, etc.) — same rationale as LawyerProfile.feeStructure:
// shape varies enough per engagement that a fixed relational schema isn't
// worth it. `retainerAmount` inside it is what gets charged as the Payment
// on acceptance.
model Proposal {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  lawyerId       String
  lawyer         User         @relation("LawyerProposals", fields: [lawyerId], references: [id])
  clientId       String
  client         User         @relation("ClientProposals", fields: [clientId], references: [id])

  feeStructure Json
  status       ProposalStatus @default(SENT)

  createdAt DateTime @default(now())

  case Case?

  @@index([consultationId])
}

enum CaseStatus {
  PENDING_PAYMENT
  ACTIVE
  CLOSED
}

// Created the moment a client accepts a Proposal (status PENDING_PAYMENT,
// alongside the retainer Payment); flips to ACTIVE once an admin approves
// that payment (see paymentService/adminService). A client may only have
// one ACTIVE case at a time — enforced in proposalService (at acceptance)
// and again in adminService (at activation, to close the race where two
// proposals are accepted before either retainer is reviewed). Lawyers have
// no such limit.
model Case {
  id         String   @id @default(uuid())
  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  clientId   String
  client     User     @relation("ClientCases", fields: [clientId], references: [id])
  lawyerId   String
  lawyer     User     @relation("LawyerCases", fields: [lawyerId], references: [id])

  status CaseStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now())

  payments Payment[]
  disputes Dispute[]

  @@index([clientId, status])
}

// Threads are scoped per consultation or per case, not one continuous
// inbox per client-lawyer pair. threadId is a plain column (not a relation)
// since it points at either Consultation or, once Phase 7 lands, Case —
// ownership/"no contact until paid" checks are enforced in messageService.
enum ThreadType {
  CONSULTATION
  CASE
}

model Message {
  id         String     @id @default(uuid())
  threadType ThreadType
  threadId   String

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  body          String
  attachmentUrl String?
  // Admin moderation (11.2a) — toggled via PATCH /api/admin/messages/:id/flag.
  isFlagged     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadType, threadId])
}

enum DocumentCategory {
  PLEADING
  EVIDENCE
  COURT_ORDER
  PERSONAL
  CREDENTIAL
}

// A document library entry. caseId is a plain nullable column (not a
// relation) until the Case model lands in Phase 7 (Track B) — same pattern
// as Payment's polymorphic FKs above. Versioning: re-uploading "the same"
// document doesn't create an unrelated row — it's posted with `replaces`
// set to the prior version's id, and the service carries the shared
// `groupId` forward with `version` incremented. GET /api/documents returns
// only the latest version per group by default.
model Document {
  id       String @id @default(uuid())
  ownerId  String
  owner    User   @relation("DocumentOwner", fields: [ownerId], references: [id])
  caseId   String?

  category DocumentCategory
  url      String
  originalName String
  mimeType String
  size     Int

  // All versions of the same logical document share a groupId; a
  // first-time upload gets groupId == id.
  groupId String
  version Int    @default(1)

  uploadedAt DateTime @default(now())

  @@index([ownerId])
  @@index([caseId])
  @@index([groupId])
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

// A client or lawyer flagging a problem on their own case for admin
// mediation (PRD §6.7/11.1) — e.g. a missed session or a fee disagreement.
// caseId is a real relation (unlike Payment's polymorphic FKs) since a
// dispute is always case-scoped; raisedById can be either party on the
// case, checked in disputeService rather than the schema. `resolution` is
// only set once an admin closes it out via PATCH .../:id.
model Dispute {
  id          String @id @default(uuid())
  raisedById  String
  raisedBy    User   @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  caseId      String
  case        Case   @relation(fields: [caseId], references: [id])

  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?

  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([caseId])
  @@index([status])
}
